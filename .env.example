# ---------------------------------------------------------------------------
# Copy to .env and fill in.  .env is gitignored — never commit real keys.
# ---------------------------------------------------------------------------

# REQUIRED — Retell dashboard → API Keys.  Starts with "key_".
RETELL_API_KEY=

# Filled in by `python -m agent.provision` after it creates the agents.
# Two agent IDs = the two arms of the ablation (identical except the prompt).
RETELL_AGENT_ID_NAIVE=
RETELL_AGENT_ID_HARDENED=

# Chat-channel counterparts (text arm of the 2x2). Also set by provision.
RETELL_CHAT_AGENT_ID_NAIVE=
RETELL_CHAT_AGENT_ID_HARDENED=

# ---------------------------------------------------------------------------
# Secondary LLM judge — OPTIONAL.
# The deterministic scorer runs fine with none of these set; the judge only
# supplies the clearly-labelled fuzzy signals (tone, confirm-back, invented
# availability).  First provider with a key present wins unless JUDGE_PROVIDER
# is set explicitly.
# ---------------------------------------------------------------------------
# one of: anthropic | openai | gemini | none   (leave blank to auto-detect)
# NOTE: no inline comments after a value — dotenv keeps them as part of the value.
JUDGE_PROVIDER=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# ---------------------------------------------------------------------------
# Caller-audio TTS. Used ONCE by `python -m harness.tts build` to render the
# committed WAV fixtures. Not needed to replay runs — fixtures are in-repo.
# ---------------------------------------------------------------------------
TTS_PROVIDER=openai
TTS_VOICE=alloy

# ---------------------------------------------------------------------------
# Cost guard. The runner refuses to start a batch it estimates will exceed
# this, and aborts mid-batch if actual spend crosses it. Retell gives $10 free.
# ---------------------------------------------------------------------------
MAX_SPEND_USD=8.00
MAX_CALL_SECONDS=120
